{
  "name": "taskcorp-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start:local": "tsx src/server.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "rollback": "tsx src/cli/migrate.ts --rollback",
    "bootstrap-admin": "tsx src/cli/bootstrap-admin.ts",
    "audit:security": "npm audit --audit-level=high",
    "test": "tsx tests/validation.test.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.0.0",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
